// -------------------------------------------------------------
// Factory Reset Routine (Triggered via 5-second hold)
// -------------------------------------------------------------

void performFactoryReset() {
  for (int i = 0; i < 8; i++) {
    setLed(15, 0, 0);
    delay(70);
    setLed(0, 0, 0);
    delay(70);
  }

  prefs.begin("sec_real", false);
  prefs.clear();
  prefs.end();

  prefs.begin("sec_decoy", false);
  prefs.clear();
  prefs.end();

  setLed(0, 15, 0);
  delay(1200);

  ESP.restart();
}

// -------------------------------------------------------------
// Setup & Routing
// -------------------------------------------------------------

void setup() {
  pinMode(BOOT_BTN, INPUT_PULLUP);

  // Seed default Real secrets if empty
  prefs.begin("sec_real", false);
  if (!prefs.isKey("count")) {
    prefs.putInt("count", 2);
    prefs.putString("k_0", "Production Master API");
    prefs.putString("v_0", "live_sk_prod_99182xKeyDelta");
    prefs.putString("k_1", "Root Recovery Seed");
    prefs.putString("v_1", "strike-echo-bravo-7749-cipher-blue");
  }
  prefs.end();

  // Seed default Decoy secrets if empty
  prefs.begin("sec_decoy", false);
  if (!prefs.isKey("count")) {
    prefs.putInt("count", 2);
    prefs.putString("k_0", "Staging Test Token");
    prefs.putString("v_0", "ghp_testTokenSample98372Expired");
    prefs.putString("k_1", "Sandbox API Key");
    prefs.putString("v_1", "sbx_key_demo_staging_77192");
  }
  prefs.end();

  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASS);

  dnsServer.start(DNS_PORT, "*", WiFi.softAPIP());

  server.on("/status", HTTP_GET, []() {
    if (sessionUnlocked) {
      server.send(200, "text/plain", "UNLOCKED");
    } else {
      server.send(200, "text/plain", "LOCKED");
    }
  });

  server.on("/locked-screen", HTTP_GET, []() {
    server.send(200, "text/html", getLockedOutPage());
  });

  server.on("/", HTTP_GET, []() {
    if (sessionUnlocked) {
      server.send(200, "text/html", getDashboardPage());
    } else {
      server.send(200, "text/html", getLoginPage());
    }
  });

  server.on("/gen-pass", HTTP_GET, []() {
    if (!sessionUnlocked) {
      server.send(403, "text/plain", "Forbidden");
      return;
    }
    const char charset[] = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%&*?";
    String pwd = "";
    for (int i = 0; i < 20; i++) {
      uint32_t r = esp_random();
      pwd += charset[r % (sizeof(charset) - 1)];
    }
    server.send(200, "text/plain", pwd);
  });

  server.on("/auth", HTTP_POST, []() {
    if (millis() < lockoutUntil) {
      unsigned long secLeft = (lockoutUntil - millis()) / 1000 + 1;
      server.send(200, "text/html", getLoginPage("Rate limited. Wait " + String(secLeft) + "s."));
      return;
    }

    if (server.hasArg("pin")) {
      String enteredPin = server.arg("pin");

      if (enteredPin == REAL_PIN) {
        failedAttempts = 0;
        isDecoyMode = false;
        waitingForPresence = true;
        presenceTimer = millis();
        setLed(0, 0, 15);
        server.send(200, "text/html", getWaitingPresencePage());
        return;
      }
      else if (enteredPin == DECOY_PIN) {
        failedAttempts = 0;
        isDecoyMode = true;
        waitingForPresence = true;
        presenceTimer = millis();
        setLed(0, 0, 15);
        server.send(200, "text/html", getWaitingPresencePage());
        return;
      }
    }

    failedAttempts++;
    if (failedAttempts >= 3) {
      lockoutUntil = millis() + (failedAttempts * 10000);
    }

    setLed(15, 0, 0);
    server.send(200, "text/html", getLoginPage("Invalid Master PIN"));
    delay(400);
    setLed(6, 4, 0);
  });

  server.on("/vault", HTTP_GET, []() {
    if (sessionUnlocked) {
      server.send(200, "text/html", getDashboardPage());
    } else {
      server.send(200, "text/html", getWaitingPresencePage());
    }
  });

  server.on("/add", HTTP_POST, []() {
    if (!sessionUnlocked) {
      server.sendHeader("Location", "/");
      server.send(303);
      return;
    }
    if (server.hasArg("lbl") && server.hasArg("val")) {
      prefs.begin(getActiveNamespace(), false);
      int count = prefs.getInt("count", 0);
      String keyLabel = "k_" + String(count);
      String keyVal   = "v_" + String(count);
      prefs.putString(keyLabel.c_str(), server.arg("lbl"));
      prefs.putString(keyVal.c_str(), server.arg("val"));
      prefs.putInt("count", count + 1);
      prefs.end();
    }
    server.sendHeader("Location", "/vault");
    server.send(303);
  });

  server.on("/del", HTTP_GET, []() {
    if (!sessionUnlocked) {
      server.sendHeader("Location", "/");
      server.send(303);
      return;
    }
    if (server.hasArg("idx")) {
      int targetIdx = server.arg("idx").toInt();
      prefs.begin(getActiveNamespace(), false);
      int count = prefs.getInt("count", 0);

      if (targetIdx >= 0 && targetIdx < count) {
        for (int i = targetIdx; i < count - 1; i++) {
          String nextLbl = prefs.getString(("k_" + String(i + 1)).c_str(), "");
          String nextVal = prefs.getString(("v_" + String(i + 1)).c_str(), "");
          prefs.putString(("k_" + String(i)).c_str(), nextLbl);
          prefs.putString(("v_" + String(i)).c_str(), nextVal);
        }
        prefs.remove(("k_" + String(count - 1)).c_str());
        prefs.remove(("v_" + String(count - 1)).c_str());
        prefs.putInt("count", count - 1);
      }
      prefs.end();
    }
    server.sendHeader("Location", "/vault");
    server.send(303);
  });

  server.on("/lock", HTTP_GET, []() {
    sessionUnlocked = false;
    waitingForPresence = false;
    setLed(6, 4, 0);
    server.sendHeader("Location", "/locked-screen");
    server.send(303);
  });

  server.onNotFound([]() {
    server.sendHeader("Location", "http://192.168.4.1/");
    server.send(302, "text/plain", "");
  });

  server.begin();
  setLed(6, 4, 0);
}

// -------------------------------------------------------------
// Main Loop
// -------------------------------------------------------------

void loop() {
  dnsServer.processNextRequest();
  server.handleClient();

  // Inactivity auto-lock
  if (sessionUnlocked && (millis() - lastActivityTime > SESSION_TIMEOUT_MS)) {
    sessionUnlocked = false;
    waitingForPresence = false;
    setLed(6, 4, 0);
  }

  // Presence window timeout
  if (waitingForPresence && (millis() - presenceTimer > PRESENCE_TIMEOUT_MS)) {
    waitingForPresence = false;
    setLed(6, 4, 0);
  }

  // Physical BOOT Button Interactions
  if (digitalRead(BOOT_BTN) == LOW) {
    delay(50); // Debounce
    if (digitalRead(BOOT_BTN) == LOW) {
      
      // Case A: Waiting for presence after PIN -> Short tap unlocks
      if (waitingForPresence) {
        waitingForPresence = false;
        sessionUnlocked = true;
        lastActivityTime = millis();
        setLed(0, 15, 0);
        
        while (digitalRead(BOOT_BTN) == LOW) { delay(20); }
        delay(200);
      }
      // Case B: Already unlocked -> Short tap triggers Panic Lock
      else if (sessionUnlocked) {
        sessionUnlocked = false;
        setLed(6, 4, 0);
        
        while (digitalRead(BOOT_BTN) == LOW) { delay(20); }
        delay(200);
      }
      // Case C: At locked / login screen -> Long-press 5s for Factory Reset
      else if (!sessionUnlocked && !waitingForPresence) {
        unsigned long pressStart = millis();
        bool resetTriggered = false;

        while (digitalRead(BOOT_BTN) == LOW) {
          unsigned long elapsed = millis() - pressStart;

          // Strobe warning colors after 1s
          if (elapsed > 1000) {
            setLed(15, 0, 0);
            delay(60);
            setLed(12, 10, 0);
            delay(60);
          }

          if (elapsed >= 5000) {
            resetTriggered = true;
            break;
          }
          delay(20);
        }

        if (resetTriggered) {
          performFactoryReset();
        } else {
          setLed(6, 4, 0); // Released early: Cancel and return to Dim Amber
        }
      }
    }
  }
}
